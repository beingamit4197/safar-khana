rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for archive content; writes only via Admin SDK (Cloud Functions).
    match /channel/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /videos/{videoId} {
      allow read: if true;
      allow write: if false;
    }
    match /playlists/{playlistId} {
      allow read: if true;
      allow write: if false;
    }
    match /syncMeta/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
