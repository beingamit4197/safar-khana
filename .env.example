# Frontend: copy to .env.local (never commit real values).
# Values come from Firebase console → Project settings → Your apps → Web app.
REACT_APP_USE_FIRESTORE=false
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=

# Backend (Cloud Functions) — set as secrets/params, not in this file:
#   firebase functions:secrets:set YOUTUBE_API_KEY
#   firebase functions:secrets:set SYNC_TOKEN
#   YOUTUBE_CHANNEL_ID is prompted on first `firebase deploy`
#
# Local dry-run (no Firestore writes):
#   cd functions && YOUTUBE_API_KEY=... YOUTUBE_CHANNEL_ID=@handle npm run sync:local
